  "queries": {
    "find_similar_cases": "MATCH (c:case)-[:uses]->(w:weapon)<-[:uses]-(other:case) WHERE c.id = $case_id RETURN other, count(w) as shared_weapons ORDER BY shared_weapons DESC",
    "find_weapons_for_problem": "MATCH (w:weapon)<-[:belongs_to]-(t:theory)-[:addresses]->(p:problem) WHERE p.id = $problem_id RETURN w",
    "find_cases_in_industry": "MATCH (c:case)-[:operates_in]->(i:industry) WHERE i.id = $industry_id RETURN c",
    "find_theories_for_case": "MATCH (c:case)-[:validates]->(t:theory) WHERE c.id = $case_id RETURN t"
  }
