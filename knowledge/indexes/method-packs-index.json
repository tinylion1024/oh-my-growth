      ],
      "categories": [
        "b2b-sales",
        "plg",
        "brand"
      ],
      "stage_fit": [
        "0-1",
        "1-10"
      ],
      "source_skills": [
        "coreyhaines31/launch-strategy",
        "coreyhaines31/product-marketing-context",
        "coreyhaines31/sales-enablement",
        "phuryn/beachhead-segment",
        "phuryn/competitive-battlecard",
        "phuryn/gtm-motions",
        "phuryn/gtm-strategy",
        "phuryn/ideal-customer-profile",
        "phuryn/positioning-ideas",
        "phuryn/value-prop-statements",
        "infrasity-labs/dev-gtm-claude-skills"
      ],
      "canonical_questions": [
        "哪个细分市场最痛、最容易触达、最能形成可复用案例？",
        "客户为什么现在必须换，而不是继续忍受现状或用替代品？",
        "GTM motion 应该由产品自助、销售驱动、渠道伙伴还是内容引导？"
      ],
      "decision_rules": [
        "先选 beachhead，再写泛化定位。",
        "价值主张必须连接痛点、结果、差异和可信证据。",
        "Launch 不是发布公告，而是围绕一个可验证市场假设组织渠道和销售动作。"
      ],
      "experiment_shapes": [
        "选 2 个 ICP 细分做信息访谈和冷启动外联，比较回复率与问题强度。",
        "用 3 个定位角度测试落地页、外联和销售通话质量。",
        "为一个 feature launch 设计 2 周多渠道发布，观察高意向线索。"
      ],
      "guardrails": [
        "不要同时追多个 ICP，导致信息和渠道都不可验证。",
        "不要把功能列表当定位。",
        "不要在没有销售反馈时写 battlecard。"
      ],
      "related_weapons": [
        "b2b-sales",
        "plg",
        "brand"
      ],
      "related_failures": [
        "knowledge/failures/acquisition-anti-patterns.md",
        "knowledge/failures/retention-failure-modes.md"
      ],
      "file": "method-packs/gtm-positioning-system.md"
